{
  "manifest_version": 3,
  "name": "RELO",
  "version": "0.1.0",
  "description": "Designate one YouTube tab as a desktop playback receiver and control it locally.",
  "icons": {
    "16": "icons/relo-icon-16.png",
    "32": "icons/relo-icon-32.png",
    "48": "icons/relo-icon-48.png",
    "128": "icons/relo-icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RELO — Desktop Receiver",
    "default_icon": {
      "16": "icons/relo-icon-16.png",
      "32": "icons/relo-icon-32.png",
      "48": "icons/relo-icon-48.png",
      "128": "icons/relo-icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ]
}
